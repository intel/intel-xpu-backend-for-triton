+        # After guard, b is guaranteed non-zero - emit assume if in kernel context
+        if hasattr(V.kernel, 'compute'):
+            V.kernel.compute.writeline(f"tl.assume({b} != 0)")
         b_neg = ops.lt(b, zero)
         a = ops.where(b_neg, ops.sub(zero, a), a)
