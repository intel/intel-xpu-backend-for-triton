@@ -315,7 +315,21 @@ def test_fused_moe(
     w1 = torch.randn((e, 2 * n, k), device="cuda", dtype=dtype) / 10
     w2 = torch.randn((e, k, n), device="cuda", dtype=dtype) / 10

     score = torch.randn((m, e), device="cuda", dtype=dtype)
+
+    # Random BF16 scores can tie at the top-k boundary. Tied experts are
+    # equally valid, but top-k implementations may select different IDs,
+    # causing false test failures. Reroll only rows with boundary ties.
+    for _ in range(10):
+        routing_scores = torch.softmax(score, dim=-1, dtype=torch.float32)
+        topk_plus_one = torch.topk(routing_scores, topk + 1, dim=-1).values
+        boundary_ties = topk_plus_one[:, topk - 1] == topk_plus_one[:, topk]
+        if not torch.any(boundary_ties):
+            break
+
+        score[boundary_ties] = torch.randn_like(score[boundary_ties])
+    else:
+        raise AssertionError("Failed to generate scores without top-k boundary ties")

     if ep_size > 1:
         local_e = e // ep_size
