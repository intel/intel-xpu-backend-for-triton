+++ b/tests/kernels/moe/test_silu_mul_fp8_quant_deep_gemm.py
@@ -58,6 +58,41 @@ def as_uint8(x) -> torch.Tensor:
     )
 
 
+def fp8_to_ordered_int(x: torch.Tensor) -> torch.Tensor:
+    """Map finite E4M3 values to consecutive integers in numerical order."""
+    bits = as_uint8(x).to(torch.int16)
+    sign = (bits & 0x80) != 0
+
+    if x.dtype == torch.float8_e4m3fn:
+        magnitude = bits & 0x7F
+        assert not torch.any(magnitude == 0x7F), "FP8 comparison does not allow NaN"
+        # E4M3FN has signed zero and two NaN encodings. Collapse +/-0 to
+        # one rank and exclude the NaN encodings from the finite sequence.
+        return torch.where(
+            magnitude == 0,
+            126,
+            torch.where(sign, 254 - bits, 126 + bits),
+        )
+
+    if x.dtype == torch.float8_e4m3fnuz:
+        assert not torch.any(bits == 0x80), "FP8 comparison does not allow NaN"
+        # E4M3FNUZ uses the negative-zero encoding for its only NaN.
+        return torch.where(sign, 255 - bits, 127 + bits)
+
+    raise ValueError(f"Unsupported FP8 dtype: {x.dtype}")
+
+
+def assert_fp8_adjacent(actual: torch.Tensor, expected: torch.Tensor) -> None:
+    assert actual.shape == expected.shape
+    assert actual.dtype == expected.dtype
+    torch.testing.assert_close(
+        fp8_to_ordered_int(actual),
+        fp8_to_ordered_int(expected),
+        atol=1,
+        rtol=0,
+    )
+
+
