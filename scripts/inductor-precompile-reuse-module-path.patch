 def _load_triton_kernel_from_source(
-    kernel_name: str, source_code: str
+    kernel_name: str, source_code: str, module_path: str | None = None
 ) -> CachingAutotuner:
+    if module_path is not None and os.path.exists(module_path):
+        # Triton's cache key hashes the kernel's source file path. The caller has
+        # already written this source to PyCodeCache (possibly with a non-empty
+        # ``extra``, which changes the file name), so compile from that very file:
+        # re-writing it with ``extra=""`` would yield a second copy under another
+        # path and the compilation done here would miss in the parent. Load a fresh
+        # module rather than the cached one so the result is not shared with
+        # modules the parent already holds for this path.
+        key = os.path.splitext(os.path.basename(module_path))[0]
+        mod = _reload_python_module(key, module_path, set_sys_modules=False)
+        return getattr(mod, kernel_name)
     return getattr(PyCodeCache.load(source_code), kernel_name)
 
 
