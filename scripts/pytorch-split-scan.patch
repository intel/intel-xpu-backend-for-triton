 class XPUReductionHeuristic(ReductionHeuristic):
     """Reduction configs for XPU devices."""
 
+    # Larger R0_BLOCK candidates than the generic reduction configs (<= 2048);
+    # long split scans are much faster with them. Autotuning picks per shape.
+    _SPLIT_SCAN_EXTRA_BLOCKS = ((4096, 8), (8192, 16), (16384, 8))
+
+    def get_split_scan_configs(
+        self,
+        *,
+        size_hints: dict[str, int],
+        inductor_meta: dict[str, Any],
+        triton_meta: dict[str, Any],
+    ) -> list[Config]:
+        configs = super().get_split_scan_configs(
+            size_hints=size_hints,
+            inductor_meta=inductor_meta,
+            triton_meta=triton_meta,
+        )
+        if not configs:
+            return configs
+        import copy
+
+        rnumel = size_hints.get("r0_", 0)
+        min_rblock = inductor_meta.get("min_split_scan_rblock", 256)
+        seen = {
+            (cfg.kwargs.get("R0_BLOCK"), cfg.num_warps)  # type: ignore[union-attr]
+            for cfg in configs
+        }
+        for r0_block, num_warps in self._SPLIT_SCAN_EXTRA_BLOCKS:
+            if r0_block > rnumel or r0_block < min_rblock:
+                continue
+            if (r0_block, num_warps) in seen:
+                continue
+            cfg = copy.deepcopy(configs[0])
+            cfg.kwargs["R0_BLOCK"] = r0_block  # type: ignore[union-attr]
+            cfg.num_warps = num_warps  # type: ignore[union-attr]
+            configs.append(cfg)
+        return configs
+
