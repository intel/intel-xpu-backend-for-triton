+def _sgl_fused_experts_supports(
+    hidden_states: torch.Tensor,
+    w1: torch.Tensor,
+    w2: torch.Tensor,
+    *,
+    quantized: bool,
+) -> bool:
+    """Whether sgl-kernel-xpu's grouped GEMM can take these operands.
+
+    The unquantized XPU route ends in ``moe_grouped_mm_nt_xe20``, which is built
+    for bfloat16 only -- its kernels live under ``kernels/moe/xe20/bf16`` and the
+    launcher template carries no element type -- and which reads A and B through
+    2D block loads whose pitch is the row length in bytes, so the hardware wants
+    that 16-byte aligned. The kernel checks neither: another dtype aborts from
+    the middle of the model, and an unaligned row silently returns wrong numbers.
+    The rule is known on the sgl-kernel side -- its own ``silu_and_mul`` wrapper
+    rejects a row that is not a multiple of 16 bytes -- just not applied here.
+
+    So keep operands it cannot handle on the Triton path below, which has no such
+    restriction. The quantized routes go to different operators
+    (``moe_grouped_mm_nt_xe20_fp8_w8a16``, ``_w4a16``) whose envelope this has not
+    characterized, so they are left exactly as they were.
+    """
+    if quantized:
+        return True
+    for tensor in (hidden_states, w1, w2):
+        if tensor.dtype != torch.bfloat16:
+            return False
+        if (tensor.shape[-1] * tensor.element_size()) % 16 != 0:
+            return False
+    return True
+
+
