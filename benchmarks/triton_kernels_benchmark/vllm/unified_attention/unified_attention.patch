+    td_qo_eligible = all_args["TD_QO_ELIGIBLE"]
+
+    valid_configs = []
+    for config in configs:
+        heads_option = config.kwargs["HEADS_PER_PROGRAM"]
+        heads = heads_option or num_queries_per_kv
+        if heads_option and (heads >= num_queries_per_kv or num_queries_per_kv % heads):
+            continue
+        if heads_option and not (
