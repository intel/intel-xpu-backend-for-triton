+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Offline attention profiles; importing this module does not initialize a GPU."""
+
+import hashlib
+import json
+import logging
+import os
+import re
+import tempfile
+from bisect import bisect_left
+from contextlib import contextmanager
+from dataclasses import asdict, dataclass, fields
+from functools import cache
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+SCHEMA_VERSION = 4
+KEY_VERSION = 2
+KERNEL_CONTRACT = "ua-offline-v1"
+_BUNDLED_DIR = Path(__file__).parent / "configs" / "unified_attention"
+_UNSET = object()
+_override = _UNSET
+_offline = False
+_last_resolution = None
+_last_profile_match = None
+
+
+@dataclass(frozen=True)
+class AttentionConfig:
+    block_m: int
+    tile_size: int
+    num_warps: int | None = None
+    num_stages: int | None = None
+    grf_mode: str | None = None
+
+    def launch_kwargs(self, backend: str) -> dict:
+        options = {
+            "num_warps": self.num_warps,
+            "num_stages": self.num_stages,
+        }
+        if backend == "xpu":
+            options["grf_mode"] = self.grf_mode
+        return {name: value for name, value in options.items() if value is not None}
+
+
+@dataclass(frozen=True)
+class AttentionStaticKey:
+    block_size: int
+    head_size: int
+    num_queries_per_kv: int
+    use_td: bool
+    kv_quant_mode: int
+    use_softcap: bool
+    sliding_window: int
+    q_dtype: str
+    k_dtype: str
+    v_dtype: str
+    out_dtype: str
+    q_layout: str
+    kv_layout: str
+
+
+@dataclass(frozen=True)
+class AttentionDynamicKey:
+    is_3d: bool
+    num_segments: int
+    q_len_bucket: int
+    kv_len_bucket: int
+    query_work: int
+
+    def regime(self) -> tuple:
+        return self.is_3d, self.num_segments, self.q_len_bucket, self.kv_len_bucket
+
+
+@dataclass(frozen=True)
+class AttentionKey(AttentionStaticKey, AttentionDynamicKey):
+    def static_key(self) -> AttentionStaticKey:
+        return AttentionStaticKey(
+            **{
+                field.name: getattr(self, field.name)
+                for field in fields(AttentionStaticKey)
+            }
+        )
+
+    def dynamic_key(self) -> AttentionDynamicKey:
+        return AttentionDynamicKey(
+            **{
+                field.name: getattr(self, field.name)
+                for field in fields(AttentionDynamicKey)
+            }
+        )
+
+
+def make_key(
+    *,
+    block_size,
+    head_size,
+    is_3d,
+    num_queries_per_kv,
+    use_td,
+    max_seqlen_q,
+    max_seqlen_k,
+    kv_quant_mode,
+    use_softcap,
+    sliding_window,
+    q_dtype,
+    k_dtype,
+    v_dtype,
+    out_dtype,
+    num_segments,
+    query_work,
+    q_layout="contiguous",
+    kv_layout="contiguous",
+) -> AttentionKey:
+    return AttentionKey(
+        block_size=block_size,
+        head_size=head_size,
+        is_3d=is_3d,
+        num_queries_per_kv=num_queries_per_kv,
+        use_td=use_td,
+        q_len_bucket=sum(max_seqlen_q > bound for bound in (1, 16, 512)),
+        kv_len_bucket=sum(max_seqlen_k > bound for bound in (256, 1024, 4096, 8192)),
+        kv_quant_mode=int(kv_quant_mode),
+        use_softcap=use_softcap,
+        sliding_window=max(0, sliding_window),
+        **dict(
+            zip(
+                ("q_dtype", "k_dtype", "v_dtype", "out_dtype"),
+                (
+                    str(dtype).removeprefix("torch.")
+                    for dtype in (q_dtype, k_dtype, v_dtype, out_dtype)
+                ),
+            )
+        ),
+        num_segments=num_segments,
+        query_work=query_work,
+        q_layout=q_layout,
+        kv_layout=kv_layout,
+    )
+
+
+def _power_of_two(value) -> bool:
+    return type(value) is int and value > 0 and value & (value - 1) == 0
+
+
+def _valid_key(key: AttentionKey) -> bool:
+    positive = (
+        key.block_size,
+        key.head_size,
+        key.num_queries_per_kv,
+        key.num_segments,
+        key.query_work,
+    )
+    if any(type(value) is not int or value <= 0 for value in positive):
+        return False
+    if any(
+        type(value) is not bool for value in (key.is_3d, key.use_td, key.use_softcap)
+    ):
+        return False
+    for value, maximum in (
+        (key.q_len_bucket, 3),
+        (key.kv_len_bucket, 4),
+        (key.kv_quant_mode, 3),
+    ):
+        if type(value) is not int or not 0 <= value <= maximum:
+            return False
+    if type(key.sliding_window) is not int or key.sliding_window < 0:
+        return False
+    if key.q_layout not in ("contiguous", "qkv"):
+        return False
+    if key.kv_layout not in ("contiguous", "interleaved"):
+        return False
+    if (not key.is_3d and key.num_segments != 1) or not _power_of_two(key.num_segments):
+        return False
+    return all(
+        type(dtype) is str and dtype
+        for dtype in (key.q_dtype, key.k_dtype, key.v_dtype, key.out_dtype)
+    )
+
+
+def validate_config(config: AttentionConfig, key: AttentionKey, backend: str) -> bool:
+    """Check launch structure before benchmarking or applying a profile."""
+    if not _valid_key(key):
+        return False
+    if type(config.block_m) is not int or config.block_m not in (16, 32, 64, 128):
+        return False
+    if type(config.tile_size) is not int or config.tile_size not in (
+        16,
+        32,
+        64,
+        128,
+        256,
+    ):
+        return False
+    if config.block_m // key.num_queries_per_kv <= 0:
+        return False
+    if config.num_warps is not None and (
+        type(config.num_warps) is not int
+        or config.num_warps not in (1, 2, 4, 8, 16, 32)
+    ):
+        return False
+    if config.num_stages is not None and (
+        type(config.num_stages) is not int or config.num_stages not in (1, 2, 3, 4)
+    ):
+        return False
+    if config.grf_mode not in (None, "default", "256"):
+        return False
+    if backend != "xpu" and config.grf_mode == "256":
+        return False
+    if key.use_td and key.block_size % config.tile_size:
+        return False
+    if key.q_dtype.startswith("float8_") and config.tile_size < 32:
+        return False
+    if (
+        key.use_td
+        and _power_of_two(key.head_size)
+        and _power_of_two(key.num_queries_per_kv)
+    ):
+        return _power_of_two(config.block_m // key.num_queries_per_kv)
+    return True
+
+
+def _valid_profile_config(config, key, backend):
+    return (
+        isinstance(config, AttentionConfig)
+        and config.num_warps is not None
+        and config.num_stages is not None
+        and config.grf_mode is not None
+        and validate_config(config, key, backend)
+    )
+
+
+@contextmanager
+def offline_mode():
+    """Establish controlled eager execution for a serial benchmark."""
+    global _offline, _last_resolution, _last_profile_match
+    previous = _offline, _last_resolution, _last_profile_match
+    _offline, _last_resolution, _last_profile_match = True, None, None
+    try:
+        yield
+    finally:
+        _offline, _last_resolution, _last_profile_match = previous
+
+
+@contextmanager
+def override_config(config: AttentionConfig | None):
+    """Force a benchmark config; None forces the original fallback."""
+    global _override
+    previous = _override
+    _override = config
+    try:
+        with offline_mode():
+            yield
+    finally:
+        _override = previous
+
+
+def last_resolution() -> tuple[AttentionKey, AttentionConfig | None] | None:
+    return _last_resolution
+
+
+def last_profile_match() -> dict | None:
+    return _last_profile_match
+
+
+def _eager_execution(execution_mode: str | None = None) -> bool:
+    if _offline:
+        return True
+    if execution_mode not in (None, "eager"):
+        return False
+    try:
+        from vllm.config import CUDAGraphMode
+        from vllm.forward_context import get_forward_context
+
+        if get_forward_context().cudagraph_runtime_mode != CUDAGraphMode.NONE:
+            return False
+        if execution_mode == "eager":
+            return True
+        from vllm.config.vllm import get_current_vllm_config_or_none
+
+        config = get_current_vllm_config_or_none()
+        return (
+            config is not None
+            and config.compilation_config.cudagraph_mode == CUDAGraphMode.NONE
+        )
+    except (ImportError, AttributeError, AssertionError):
+        return False
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+@cache
+def _device_identity(backend: str, index: int) -> dict | None:
+    if backend != "xpu":
+        return None
+    try:
+        import torch
+        import triton.backends.intel.compiler as intel_compiler
+        from triton.runtime.cache import triton_key
+
+        props = torch.xpu.get_device_properties(index)
+        source_dir = Path(__file__).parent
+        return {
+            "schema_version": SCHEMA_VERSION,
+            "key_version": KEY_VERSION,
+            "kernel_contract": KERNEL_CONTRACT,
+            "target": {
+                "backend": backend,
+                "device_name": props.name,
+                "architecture": f"{props.architecture}:{props.device_id}",
+            },
+            "compiler_build": {
+                "triton": hashlib.sha256(triton_key().encode()).hexdigest(),
+                "backend": _sha256(Path(intel_compiler.__file__)),
+            },
+            "execution_mode": "eager",
+            "provenance": {
+                "kernel_sha256": _sha256(source_dir / "triton_unified_attention.py"),
+                "helpers_sha256": _sha256(source_dir / "triton_attention_helpers.py"),
+                "resolver_sha256": _sha256(Path(__file__)),
+            },
+        }
+    except (ImportError, AttributeError, OSError, RuntimeError):
+        _warn_once(
+            "identity", "Cannot identify the attention compiler/device; using fallback"
+        )
+        return None
+
+
+def get_profile_identity(device) -> dict | None:
+    """Describe the installed source and actual query device for eager profiles."""
+    import torch
+
+    device = torch.device(device)
+    if device.type != "xpu":
+        return None
+    index = device.index if device.index is not None else torch.xpu.current_device()
+    identity = _device_identity(device.type, index)
+    return json.loads(json.dumps(identity)) if identity is not None else None
+
+
+def _compatibility(identity: dict) -> dict:
+    if (
+        type(identity) is not dict
+        or type(identity.get("schema_version")) is not int
+        or identity["schema_version"] != SCHEMA_VERSION
+        or type(identity.get("key_version")) is not int
+        or identity["key_version"] != KEY_VERSION
+        or identity.get("kernel_contract") != KERNEL_CONTRACT
+        or identity.get("execution_mode") != "eager"
+    ):
+        raise ValueError("unsupported profile identity")
+    target = identity["target"]
+    if target["backend"] != "xpu" or any(
+        type(target[name]) is not str or not target[name]
+        for name in ("device_name", "architecture")
+    ):
+        raise ValueError("unsupported profile target")
+    hashes = [identity["compiler_build"][name] for name in ("triton", "backend")]
+    hashes += [
+        identity["provenance"][name]
+        for name in ("kernel_sha256", "helpers_sha256", "resolver_sha256")
+    ]
+    if any(
+        type(value) is not str
+        or len(value) != 64
+        or any(char not in "0123456789abcdef" for char in value)
+        for value in hashes
+    ):
+        raise ValueError("missing source or compiler identity")
+    return {
+        name: identity[name]
+        for name in (
+            "schema_version",
+            "key_version",
+            "kernel_contract",
+            "target",
+            "compiler_build",
+            "execution_mode",
+        )
+    } | {
+        "source": {
+            name: identity["provenance"][name]
+            for name in ("kernel_sha256", "helpers_sha256", "resolver_sha256")
+        }
+    }
+
+
+def _dtype_label(q_dtype: str) -> str:
+    if type(q_dtype) is not str or not re.fullmatch(r"[a-z0-9_]+", q_dtype):
+        raise ValueError("invalid profile query dtype")
+    return {"bfloat16": "bf16", "float16": "fp16", "float8_e4m3fn": "fp8"}.get(
+        q_dtype, q_dtype
+    )
+
+
+def profile_filename(identity: dict, static_key: AttentionStaticKey) -> str:
+    dtype = _dtype_label(static_key.q_dtype)
+    compatibility = _compatibility(identity) | {"static_key": asdict(static_key)}
+    digest = hashlib.sha256(
+        json.dumps(compatibility, sort_keys=True).encode()
+    ).hexdigest()[:24]
+    device = identity["target"]["device_name"].lower()
+    device = re.sub(r"\((?:r|tm)\)", "", device)
+    device = re.sub(r"\b(?:intel|arc|graphics|data|center|gpu)\b", "", device)
+    device = re.sub(r"[^a-z0-9]+", "-", device).strip("-") or "xpu"
+    return (
+        f"unified_attention_{dtype}-{device}_h{static_key.head_size}"
+        f"_gqa{static_key.num_queries_per_kv}_b{static_key.block_size}_{digest}.json"
+    )
+
+
+@cache
+def _warn_once(location: str, reason: str):
+    logger.warning("Ignoring attention profile %s: %s", location, reason)
+
+
+def _unique_json_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f"duplicate JSON field {key}")
+        result[key] = value
+    return result
+
+
+def _parse_profile(data: dict, identity: dict, static_key: AttentionStaticKey) -> dict:
+    if type(data) is not dict or _compatibility(data) != _compatibility(identity):
+        raise ValueError("incompatible profile identity")
+    recorded_static = AttentionStaticKey(**data["static_key"])
+    if recorded_static != static_key:
+        raise ValueError("profile static key mismatch")
+    if not _valid_key(
+        AttentionKey(
+            **asdict(recorded_static),
+            is_3d=False,
+            num_segments=1,
+            q_len_bucket=0,
+            kv_len_bucket=0,
+            query_work=1,
+        )
+    ):
+        raise ValueError("invalid static key")
+    if type(data.get("entries")) is not list:
+        raise ValueError("entries must be a list")
+    tables = {}
+    for entry in data["entries"]:
+        dynamic = AttentionDynamicKey(**entry["key"])
+        key = AttentionKey(**asdict(recorded_static), **asdict(dynamic))
+        if not _valid_key(key):
+            raise ValueError("invalid workload key")
+        policy = entry["policy"]
+        if policy == {"kind": "fallback"}:
+            config = None
+        elif (
+            type(policy) is dict
+            and set(policy) == {"kind", "config"}
+            and policy["kind"] == "config"
+        ):
+            config = AttentionConfig(**policy["config"])
+            if not _valid_profile_config(config, key, identity["target"]["backend"]):
+                raise ValueError("invalid launch config")
+        else:
+            raise ValueError("invalid selection policy")
+        anchors = tables.setdefault(dynamic.regime(), {})
+        if dynamic.query_work in anchors:
+            raise ValueError("duplicate query-work anchor")
+        anchors[dynamic.query_work] = config
+    return {
+        regime: (
+            tuple(sorted(anchors)),
+            tuple(anchors[work] for work in sorted(anchors)),
+        )
+        for regime, anchors in tables.items()
+    }
+
+
+@cache
+def _load_profile(
+    path: str, identity_json: str, static_key: AttentionStaticKey
+) -> dict:
+    try:
+        with open(path) as source:
+            data = json.load(source, object_pairs_hook=_unique_json_object)
+        return _parse_profile(data, json.loads(identity_json), static_key)
+    except FileNotFoundError:
+        return {}
+    except (OSError, KeyError, TypeError, ValueError) as error:
+        _warn_once(path, str(error))
+        return {}
+
+
+@cache
+def _profile_sources(
+    backend: str, index: int, static_key: AttentionStaticKey
+) -> tuple[dict, ...]:
+    identity = get_profile_identity(f"{backend}:{index}")
+    if identity is None:
+        return ()
+    filename = profile_filename(identity, static_key)
+    identity_json = json.dumps(identity, sort_keys=True)
+    folder = os.environ.get("VLLM_TUNED_CONFIG_FOLDER")
+    paths = [Path(folder) / filename] if folder else []
+    paths.append(_BUNDLED_DIR / filename)
+    return tuple(_load_profile(str(path), identity_json, static_key) for path in paths)
+
+
+def resolve_config(
+    key: AttentionKey,
+    device,
+    *,
+    eligible: bool = True,
+    execution_mode: str | None = None,
+):
+    global _last_resolution, _last_profile_match
+    backend = getattr(device, "type", str(device).split(":")[0])
+    selected, match = None, None
+    if _override is not _UNSET:
+        selected = _override
+        if selected is not None and (
+            not eligible or not validate_config(selected, key, backend)
+        ):
+            raise ValueError("Forced attention config is invalid for this workload")
+    elif (
+        eligible
+        and backend == "xpu"
+        and _eager_execution(execution_mode)
+        and _valid_key(key)
+    ):
+        index = getattr(device, "index", None)
+        if type(index) is not int:
+            import torch
+
+            index = torch.device(device).index
+            if index is None:
+                index = torch.xpu.current_device()
+        for tables in _profile_sources(backend, index, key.static_key()):
+            table = tables.get(key.regime())
+            if table is None:
+                continue
+            anchors, configs = table
+            pos = bisect_left(anchors, key.query_work)
+            candidates = (max(0, pos - 1), min(pos, len(anchors) - 1))
+            pos = min(
+                candidates, key=lambda i: (abs(anchors[i] - key.query_work), anchors[i])
+            )
+            selected = configs[pos]
+            if selected is not None and not validate_config(selected, key, backend):
+                selected = None
+                break
+            if _offline:
+                match = {
+                    "anchor": anchors[pos],
+                    "kind": "fallback" if selected is None else "config",
+                    "lookup": "exact"
+                    if anchors[pos] == key.query_work
+                    else (
+                        "extrapolated"
+                        if key.query_work < anchors[0] or key.query_work > anchors[-1]
+                        else "nearest"
+                    ),
+                }
+            break
+    if _offline:
+        _last_resolution, _last_profile_match = (key, selected), match
+    return selected
+
+
+def write_profile(
+    path,
+    identity: dict,
+    entries,
+    *,
+    static_key: AttentionStaticKey,
+    provenance: dict | None = None,
+):
+    """Validate and atomically replace one static partition."""
+    data = dict(identity, static_key=asdict(static_key))
+    data["provenance"] = {**(provenance or {}), **identity["provenance"]}
+    data["entries"] = [
+        {
+            "key": asdict(dynamic),
+            "policy": {"kind": "fallback"}
+            if config is None
+            else {"kind": "config", "config": asdict(config)},
+        }
+        for dynamic, config in entries
+    ]
+    _parse_profile(data, identity, static_key)
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = None
+    try:
+        with tempfile.NamedTemporaryFile(
+            mode="w", dir=path.parent, delete=False, suffix=".tmp"
+        ) as output:
+            temporary = output.name
+            json.dump(data, output, indent=2, sort_keys=True, allow_nan=False)
+            output.write("\n")
+        os.replace(temporary, path)
+    finally:
+        if temporary is not None:
+            Path(temporary).unlink(missing_ok=True)
