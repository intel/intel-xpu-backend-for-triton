+@triton.jit
+def compact_attention(
+    q,
+    k,
+    v,
+    cu,
+    lengths,
+    pages,
+    out,
+    QS: tl.constexpr,
+    KH: tl.constexpr,
+    QH: tl.constexpr,
+    PS: tl.constexpr,
+    PAGE_STRIDE: tl.constexpr,
+    BM: tl.constexpr,
+    BT: tl.constexpr,
+    SCALE: tl.constexpr,
+    PRESCALE: tl.constexpr = True,
+    SPLIT_CAUSAL: tl.constexpr = True,
+    DK: tl.constexpr = 32,
+    FRAGMENT_LOOPS: tl.constexpr = True,
+):
+    block = tl.program_id(0)
+    head = tl.program_id(1)
+    batch = tl.program_id(2)
+    base = tl.load(cu + batch)
+    qlen = tl.load(cu + batch + 1) - base
+    seq_len = tl.load(lengths + batch)
+    start = block * BM
+    if start >= qlen:
+        return
+    context = seq_len - qlen
+    qd = tl.make_tensor_descriptor(
+        q + base * QS + head * 128, shape=(qlen, 128), strides=(QS, 1), block_shape=(BM, DK)
+    )
+    od = tl.make_tensor_descriptor(
+        out + base * QS + head * 128, shape=(qlen, 128), strides=(QS, 1), block_shape=(BM, 128)
+    )
+    rows = context + start + tl.arange(0, BM)
+    kvhead = head // (QH // KH)
+    m = tl.full((BM,), float("-inf"), tl.float32)
+    l = tl.zeros((BM,), tl.float32)
+    a0 = tl.zeros((BM, 32), tl.float32)
+    a1 = tl.zeros((BM, 32), tl.float32)
+    a2 = tl.zeros((BM, 32), tl.float32)
+    a3 = tl.zeros((BM, 32), tl.float32)
+    hi = tl.cdiv(tl.minimum(seq_len, context + start + BM), BT)
+    for j in range(hi):
+        physical = tl.load(pages + batch * PAGE_STRIDE + j * BT // PS).to(tl.int64)
+        offset = j * BT % PS
+        kd = tl.make_tensor_descriptor(
+            k + physical * PS * KH * 128 + kvhead * 128,
+            shape=(PS, 128),
+            strides=(KH * 128, 1),
+            block_shape=(BT, DK),
+        )
+        vd = tl.make_tensor_descriptor(
+            v + physical * PS * KH * 128 + kvhead * 128,
+            shape=(PS, 128),
+            strides=(KH * 128, 1),
+            block_shape=(BT, 32),
+        )
+        scores = tl.zeros((BM, BT), tl.float32)
+        for d in tl.range(0, 128 // DK, loop_unroll_factor=1, num_stages=2):
+            query = qd.load([start, d * DK])
+            keys = kd.load([offset, d * DK]).T
+            if PRESCALE:
+                query = (query * SCALE).to(query.dtype)
+            scores = tl.dot(query, keys, scores)
+        EXP_SCALE: tl.constexpr = 1.4426950408889634 if PRESCALE else SCALE * 1.4426950408889634
+        if (j + 1) * BT > context + start + 1:
+            cols = j * BT + tl.arange(0, BT)
+            scores = tl.where(cols[None, :] <= rows[:, None], scores, float("-inf"))
+        new_m = tl.maximum(m, tl.max(scores, 1) * EXP_SCALE)
+        prob = tl.exp2(tl.fma(scores, EXP_SCALE, -new_m[:, None]))
+        alpha = tl.exp2(m - new_m)
+        l = tl.fma(l, alpha, tl.sum(prob, 1))
+        m = new_m
+        p = prob.to(q.dtype.element_ty)
+        a0 *= alpha[:, None]
+        a1 *= alpha[:, None]
+        a2 *= alpha[:, None]
+        a3 *= alpha[:, None]
+        if FRAGMENT_LOOPS:
+            for column in tl.range(0, 4, loop_unroll_factor=2, num_stages=2):
+                if column == 0:
+                    current = a0
+                elif column == 1:
+                    current = a1
+                elif column == 2:
+                    current = a2
+                else:
+                    current = a3
+                values = vd.load([offset, column * 32])
+                current = tl.dot(p, values, current)
+                if column == 0:
+                    a0 = current
+                elif column == 1:
+                    a1 = current
+                elif column == 2:
+                    a2 = current
+                else:
+                    a3 = current
+        else:
+            v0 = vd.load([offset, 0])
+            a0 = tl.dot(p, v0, a0)
+            v1 = vd.load([offset, 32])
+            a1 = tl.dot(p, v1, a1)
+            v2 = vd.load([offset, 64])
+            a2 = tl.dot(p, v2, a2)
+            v3 = vd.load([offset, 96])
+            a3 = tl.dot(p, v3, a3)
+    acc = tl.cat(
+        tl.cat(a0.T, a1.T, can_reorder=False),
+        tl.cat(a2.T, a3.T, can_reorder=False),
+        can_reorder=False,
+    ).T
+    od.store([start, 0], (acc / l[:, None]).to(out.dtype.element_ty))
+
